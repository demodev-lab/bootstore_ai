<!-- Hero Section with Stats -->
<div class="bg-gradient-to-br from-indigo-900 via-purple-900 to-pink-900 py-16 mb-8">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h1 class="text-5xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent mb-4">
        마켓 벤치마킹 소식
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        AI 기반 스마트 스토어 분석으로 경쟁력 있는 온라인 비즈니스를 시작하세요
      </p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
      <div class="bg-white/10 backdrop-blur-lg rounded-2xl p-6 border border-white/20 hover:scale-105 transition-all duration-300">
        <div class="flex items-center justify-center w-12 h-12 bg-blue-500/20 rounded-lg mb-4 mx-auto">
          <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-white mb-1"><%= @total_stores || 0 %></div>
          <div class="text-gray-300">등록된 스토어</div>
        </div>
      </div>

      <div class="bg-white/10 backdrop-blur-lg rounded-2xl p-6 border border-white/20 hover:scale-105 transition-all duration-300">
        <div class="flex items-center justify-center w-12 h-12 bg-green-500/20 rounded-lg mb-4 mx-auto">
          <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-white mb-1"><%= @total_products || 0 %></div>
          <div class="text-gray-300">수집된 상품</div>
        </div>
      </div>

      <div class="bg-white/10 backdrop-blur-lg rounded-2xl p-6 border border-white/20 hover:scale-105 transition-all duration-300">
        <div class="flex items-center justify-center w-12 h-12 bg-purple-500/20 rounded-lg mb-4 mx-auto">
          <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
          </svg>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-white mb-1">AI</div>
          <div class="text-gray-300">스마트 분석</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container mx-auto px-4 pb-8">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Panel: Search Filters -->
    <div class="lg:col-span-1">
      <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 border border-gray-700/50 shadow-2xl hover:shadow-3xl transition-all duration-300">
        <div class="flex items-center mb-6">
          <div class="flex items-center justify-center w-10 h-10 bg-blue-500/20 rounded-lg mr-3">
            <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white">검색 필터</h3>
        </div>

        <%= form_with url: stores_path, method: :get, local: true, class: "space-y-6" do |f| %>
          <div class="space-y-4">
            <!-- All stores checkbox -->
            <div>
              <div class="bg-blue-600/20 border border-blue-500/30 rounded-lg p-4 mb-4">
                <label class="flex items-center group cursor-pointer">
                  <%= check_box_tag 'all_stores', '1', params[:all_stores], 
                      class: "w-4 h-4 text-blue-500 bg-gray-600 border-gray-500 rounded focus:ring-blue-500 focus:ring-2",
                      data: { all_stores_toggle: true } %>
                  <span class="ml-3 text-blue-300 font-semibold group-hover:text-blue-200 transition-colors">전체 스토어 타입 수집</span>
                </label>
                <p class="text-xs text-gray-400 mt-2 ml-7">✅ 선택시 모든 타입의 스토어에서 데이터를 수집합니다</p>
              </div>
            </div>

            <div id="filter-options" class="<%= 'opacity-50 pointer-events-none' if params[:all_stores] == '1' %>">
              <label class="block text-sm font-medium text-gray-300 mb-3">입점 형태</label>
              <div class="bg-gray-700/50 rounded-lg p-4">
                <label class="flex items-center group cursor-pointer">
                  <%= check_box_tag 'overseas', '1', params[:overseas], class: "w-4 h-4 text-blue-500 bg-gray-600 border-gray-500 rounded focus:ring-blue-500 focus:ring-2" %>
                  <span class="ml-3 text-gray-300 group-hover:text-white transition-colors">해외직구마켓</span>
                </label>
              </div>
            </div>

              <div>
                <label class="block text-sm font-medium text-gray-300 mb-3">최소 상품수 필터</label>
                <div class="flex items-center gap-3 bg-gray-700/50 rounded-lg p-4">
                  <%= number_field_tag 'min_products', params[:min_products] || 100,
                      class: "bg-gray-600 border border-gray-500 rounded-lg px-4 py-2 w-24 text-center text-white focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
                  <span class="text-gray-300">개 이상</span>
                </div>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-300 mb-3">판매가 범위</label>
                <div class="bg-gray-700/50 rounded-lg p-4 space-y-3">
                  <%= number_field_tag 'price_min', params[:price_min] || 0,
                      placeholder: "최소 가격",
                      class: "w-full bg-gray-600 border border-gray-500 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
                  <div class="text-center text-gray-400">~</div>
                  <%= number_field_tag 'price_max', params[:price_max] || 0,
                      placeholder: "최대 가격",
                      class: "w-full bg-gray-600 border border-gray-500 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
                </div>
              </div>
            </div>
          </div>

          <button type="button" id="reset-filters" class="w-full bg-gradient-to-r from-gray-600 to-gray-700 hover:from-gray-500 hover:to-gray-600 text-white font-semibold py-3 px-4 rounded-lg transition-all duration-300 transform hover:scale-105">
            필터 초기화
          </button>
        <% end %>
      </div>
    </div>

    <!-- Center Panel: Store Input -->
    <div class="lg:col-span-1">
      <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 border border-gray-700/50 shadow-2xl hover:shadow-3xl transition-all duration-300">
        <div class="flex items-center mb-6">
          <div class="flex items-center justify-center w-10 h-10 bg-green-500/20 rounded-lg mr-3">
            <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white">상품 정보 수집</h3>
        </div>

        <!-- 크롤링 타입 선택 탭 -->
        <div class="mb-6">
          <div class="flex bg-gray-700/30 rounded-lg p-1" role="tablist">
            <button type="button" class="crawl-tab active-tab flex-1 py-2 px-4 rounded-md text-sm font-medium transition-all duration-200" data-tab="store">
              🏪 스토어별 수집
            </button>
            <button type="button" class="crawl-tab flex-1 py-2 px-4 rounded-md text-sm font-medium transition-all duration-200" data-tab="product">
              🛍️ 상품별 수집
            </button>
          </div>
        </div>

        <!-- 스토어 URL 수집 폼 -->
        <div id="store-tab-content" class="tab-content">
          <%= form_with url: crawl_store_stores_path, local: true, class: "space-y-6" do |f| %>
            <%= hidden_field_tag :all_stores, params[:all_stores] %>
            <%= hidden_field_tag :overseas, params[:overseas] %>
            <div>
              <label class="block text-sm font-medium text-gray-300 mb-3">스토어 URL</label>
              <%= text_field_tag :store_url, nil,
                  placeholder: "https://smartstore.naver.com/theunitstore",
                  class: "w-full bg-gray-700/50 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-400 focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all" %>
              <div class="text-xs text-gray-400 mt-2">
                💡 네이버 스마트스토어 URL을 입력하세요
                <% if params[:all_stores] == '1' %>
                  <div class="text-blue-400 font-semibold mt-1">
                    🌟 전체 스토어 타입에서 수집됩니다
                  </div>
                <% elsif params[:overseas] == '1' %>
                  <div class="text-green-400 font-semibold mt-1">
                    🌍 해외직구마켓 타입에서 수집됩니다
                  </div>
                <% end %>
              </div>
            </div>

            <%= submit_tag "🚀 스토어 정보 수집 시작",
                class: "w-full bg-gradient-to-r from-green-500 to-blue-600 hover:from-green-600 hover:to-blue-700 text-white font-bold py-4 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl",
                data: { disable_with: "🔄 수집 중..." } %>
          <% end %>
        </div>

        <!-- 상품명 수집 폼 -->
        <div id="product-tab-content" class="tab-content hidden">
          <%= form_with url: search_products_stores_path, local: true, class: "space-y-6" do |f| %>
            <div>
              <label class="block text-sm font-medium text-gray-300 mb-3">상품명 검색</label>
              <%= text_field_tag :product_name, nil,
                  placeholder: "예: 아이폰 케이스, 무선이어폰, 패딩 등",
                  class: "w-full bg-gray-700/50 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-400 focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all" %>
              <div class="text-xs text-gray-400 mt-2">
                💡 찾고자 하는 상품명을 입력하세요
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-300 mb-3">수집 개수</label>
              <%= select_tag :limit,
                  options_for_select([
                    ['상위 10개', 10],
                    ['상위 20개', 20],
                    ['상위 50개', 50],
                    ['상위 100개', 100]
                  ], 20),
                  class: "w-full bg-gray-700/50 border border-gray-600 rounded-lg px-4 py-3 text-white focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all" %>
              <div class="text-xs text-gray-400 mt-2">
                📊 검색 결과에서 수집할 상품 개수를 선택하세요
              </div>
            </div>

            <%= submit_tag "🛍️ 상품 정보 수집 시작",
                class: "w-full bg-gradient-to-r from-purple-500 to-pink-600 hover:from-purple-600 hover:to-pink-700 text-white font-bold py-4 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl",
                data: { disable_with: "🔄 수집 중..." } %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Right Panel: Store Results -->
    <div class="lg:col-span-1">
      <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 border border-gray-700/50 shadow-2xl hover:shadow-3xl transition-all duration-300">
        <div class="flex justify-between items-center mb-6">
          <div class="flex items-center">
            <div class="flex items-center justify-center w-10 h-10 bg-purple-500/20 rounded-lg mr-3">
              <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-white">수집 결과</h3>
          </div>
          <button class="bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-600 hover:to-pink-600 text-white font-semibold px-4 py-2 rounded-lg transition-all duration-300 transform hover:scale-105">
            💎 소싱하기
          </button>
        </div>

        <% if @stores.any? %>
          <div class="space-y-4 max-h-96 overflow-y-auto">
            <% @stores.each_with_index do |store, index| %>
              <div class="bg-gradient-to-r from-gray-700/50 to-gray-600/50 rounded-xl p-4 border border-gray-600/30 hover:border-purple-500/50 transition-all duration-300 transform hover:scale-102">
                <div class="flex items-start justify-between mb-3">
                  <div class="flex-1">
                    <h4 class="font-semibold text-white mb-1 hover:text-purple-400 transition-colors">
                      <%= link_to store.name || "🔄 분석중...", store_path(store) %>
                    </h4>
                    <p class="text-sm text-gray-400 mb-2">
                      <%= truncate(store.url, length: 35) %>
                    </p>
                  </div>
                  <div class="text-right">
                    <div class="text-2xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">
                      <%= store.products.count %>
                    </div>
                    <div class="text-xs text-gray-400">상품</div>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-4 text-sm">
                  <div class="bg-gray-600/30 rounded-lg p-2 text-center">
                    <div class="text-white font-semibold"><%= store.product_count || 0 %></div>
                    <div class="text-gray-400 text-xs">총 상품수</div>
                  </div>
                  <div class="bg-gray-600/30 rounded-lg p-2 text-center">
                    <div class="text-white font-semibold">
                      <%= number_to_currency(store.average_price || 0, unit: "₩", precision: 0) %>
                    </div>
                    <div class="text-gray-400 text-xs">평균 가격</div>
                  </div>
                </div>

                <!-- Status indicator -->
                <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-600/30">
                  <div class="flex items-center">
                    <div class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></div>
                    <span class="text-xs text-gray-400">수집 완료</span>
                  </div>
                  <span class="text-xs text-gray-500">#<%= index + 1 %></span>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-12">
            <div class="flex items-center justify-center w-16 h-16 bg-gray-700/50 rounded-full mx-auto mb-4">
              <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2M4 13h2m13-8V4a1 1 0 00-1-1H7a1 1 0 00-1 1v1m8 0V4a1 1 0 00-1-1H9a1 1 0 00-1 1v1m0 9h6"></path>
              </svg>
            </div>
            <h4 class="text-lg font-semibold text-gray-300 mb-2">아직 수집된 데이터가 없습니다</h4>
            <p class="text-gray-400 text-sm">스토어 URL을 입력하고 수집을 시작해보세요!</p>
          </div>
        <% end %>

        <!-- Summary Stats -->
        <div class="mt-6 pt-6 border-t border-gray-700/50">
          <div class="bg-gradient-to-r from-indigo-500/10 to-purple-500/10 rounded-lg p-4">
            <h5 class="text-sm font-semibold text-gray-300 mb-3 text-center">📊 전체 통계</h5>
            <div class="grid grid-cols-2 gap-4 text-center">
              <div>
                <div class="text-xl font-bold text-indigo-400"><%= @total_products || 0 %></div>
                <div class="text-xs text-gray-400">총 상품수</div>
              </div>
              <div>
                <div class="text-xl font-bold text-purple-400">AI</div>
                <div class="text-xs text-gray-400">분석 완료</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.crawl-tab {
  color: #9ca3af;
  background: transparent;
}

.crawl-tab.active-tab {
  color: #ffffff;
  background: linear-gradient(to right, #10b981, #3b82f6);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
}

.crawl-tab:hover:not(.active-tab) {
  color: #d1d5db;
  background: rgba(75, 85, 99, 0.3);
}

.tab-content {
  transition: opacity 0.3s ease-in-out;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const tabs = document.querySelectorAll('.crawl-tab');
  const tabContents = document.querySelectorAll('.tab-content');

  tabs.forEach(tab => {
    tab.addEventListener('click', function() {
      const targetTab = this.getAttribute('data-tab');

      // Remove active class from all tabs
      tabs.forEach(t => t.classList.remove('active-tab'));

      // Add active class to clicked tab
      this.classList.add('active-tab');

      // Hide all tab contents
      tabContents.forEach(content => {
        content.classList.add('hidden');
      });

      // Show target tab content
      const targetContent = document.getElementById(targetTab + '-tab-content');
      if (targetContent) {
        targetContent.classList.remove('hidden');
      }
    });
  });

  // Handle "All stores" checkbox toggle
  const allStoresCheckbox = document.querySelector('[data-all-stores-toggle]');
  const filterOptions = document.getElementById('filter-options');
  
  if (allStoresCheckbox && filterOptions) {
    allStoresCheckbox.addEventListener('change', function() {
      if (this.checked) {
        filterOptions.classList.add('opacity-50', 'pointer-events-none');
        // Disable all inputs within filter options
        filterOptions.querySelectorAll('input').forEach(input => {
          input.disabled = true;
        });
      } else {
        filterOptions.classList.remove('opacity-50', 'pointer-events-none');
        // Enable all inputs within filter options
        filterOptions.querySelectorAll('input').forEach(input => {
          input.disabled = false;
        });
      }
    });

    // Set initial state if checkbox is already checked
    if (allStoresCheckbox.checked) {
      filterOptions.classList.add('opacity-50', 'pointer-events-none');
      filterOptions.querySelectorAll('input').forEach(input => {
        input.disabled = true;
      });
    }
  }

  // Handle reset filters button
  const resetButton = document.getElementById('reset-filters');
  if (resetButton) {
    resetButton.addEventListener('click', function() {
      // Clear all checkboxes
      document.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
        checkbox.checked = false;
      });
      
      // Clear all number inputs
      document.querySelectorAll('input[type="number"]').forEach(input => {
        input.value = input.defaultValue || '';
      });
      
      // Re-enable filter options
      if (filterOptions) {
        filterOptions.classList.remove('opacity-50', 'pointer-events-none');
        filterOptions.querySelectorAll('input').forEach(input => {
          input.disabled = false;
        });
      }
      
      // Submit the form to refresh without filters
      const form = this.closest('form');
      if (form) {
        form.submit();
      }
    });
  }
});
</script>
