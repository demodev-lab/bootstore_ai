<% content_for :title, "스토어 분석 대시보드" %>

<div class="container mx-auto px-4 py-8">
  <!-- Header Section -->
  <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-8 gap-4">
    <div>
      <h1 class="text-3xl font-bold text-white mb-2">
        스토어 분석 대시보드
      </h1>
      <p class="text-gray-400">
        네이버 스마트스토어를 자동으로 분석하고 상품 정보를 수집합니다
      </p>
    </div>

    <!-- Add Store Form -->
    <div class="bg-gray-800/50 backdrop-blur-sm rounded-lg p-6 border border-gray-700/50 lg:min-w-[400px]">
      <%= form_with url: stores_path, method: :post, local: true, class: "space-y-4" do |form| %>
        <div>
          <label class="block text-sm font-medium text-gray-300 mb-2">
            스토어 URL 추가
          </label>
          <%= form.url_field "store[url]",
                placeholder: "https://smartstore.naver.com/storename",
                class: "w-full px-4 py-3 bg-gray-700/50 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
                required: true %>
          <p class="text-xs text-gray-500 mt-1">
            네이버 스마트스토어 URL을 입력하세요
          </p>
        </div>

        <%= form.submit "스토어 분석 시작",
            class: "w-full bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white font-semibold py-3 px-6 rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg" %>
      <% end %>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-gradient-to-br from-blue-500/20 to-blue-600/20 border border-blue-500/30 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-blue-400 text-sm font-medium">총 스토어</p>
          <p class="text-2xl font-bold text-white"><%= @stores.count %></p>
        </div>
        <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-gradient-to-br from-green-500/20 to-green-600/20 border border-green-500/30 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-green-400 text-sm font-medium">완료된 분석</p>
          <p class="text-2xl font-bold text-white"><%= @stores.successful.count %></p>
        </div>
        <div class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-gradient-to-br from-purple-500/20 to-purple-600/20 border border-purple-500/30 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-purple-400 text-sm font-medium">총 상품</p>
          <p class="text-2xl font-bold text-white"><%= @stores.successful.sum(:product_count) %></p>
        </div>
        <div class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-gradient-to-br from-yellow-500/20 to-yellow-600/20 border border-yellow-500/30 rounded-lg p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-yellow-400 text-sm font-medium">분석 중</p>
          <p class="text-2xl font-bold text-white"><%= @stores.where(status: ['pending', 'scraping']).count %></p>
        </div>
        <div class="w-12 h-12 bg-yellow-500/20 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="flex flex-wrap gap-4 mb-6">
    <%= link_to stores_path,
        class: "px-4 py-2 rounded-lg #{'bg-blue-500/20 text-blue-400 border border-blue-500/30' if params[:business_type].blank?} #{'bg-gray-700/50 text-gray-400 border border-gray-600' unless params[:business_type].blank?} hover:bg-blue-500/30 transition-all duration-300" do %>
      전체
    <% end %>

    <%= link_to stores_path(business_type: 'domestic'),
        class: "px-4 py-2 rounded-lg #{'bg-blue-500/20 text-blue-400 border border-blue-500/30' if params[:business_type] == 'domestic'} #{'bg-gray-700/50 text-gray-400 border border-gray-600' unless params[:business_type] == 'domestic'} hover:bg-blue-500/30 transition-all duration-300" do %>
      국내 스토어
    <% end %>

    <%= link_to stores_path(business_type: 'overseas'),
        class: "px-4 py-2 rounded-lg #{'bg-blue-500/20 text-blue-400 border border-blue-500/30' if params[:business_type] == 'overseas'} #{'bg-gray-700/50 text-gray-400 border border-gray-600' unless params[:business_type] == 'overseas'} hover:bg-blue-500/30 transition-all duration-300" do %>
      해외 스토어
    <% end %>

    <%= link_to stores_path(business_type: 'mixed'),
        class: "px-4 py-2 rounded-lg #{'bg-blue-500/20 text-blue-400 border border-blue-500/30' if params[:business_type] == 'mixed'} #{'bg-gray-700/50 text-gray-400 border border-gray-600' unless params[:business_type] == 'mixed'} hover:bg-blue-500/30 transition-all duration-300" do %>
      혼합 스토어
    <% end %>
  </div>

  <!-- Stores Grid -->
  <% if @stores.any? %>
    <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
      <% @stores.each do |store| %>
        <div class="bg-gray-800/50 backdrop-blur-sm rounded-lg border border-gray-700/50 hover:border-gray-600 transition-all duration-300 overflow-hidden group">
          <div class="p-6">
            <!-- Store Header -->
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-white group-hover:text-blue-400 transition-colors duration-300 line-clamp-1">
                  <%= link_to store.name, store_path(store) %>
                </h3>
                <p class="text-sm text-gray-400 mt-1 line-clamp-2">
                  <%= store.description.present? ? store.description : "스토어 설명이 없습니다." %>
                </p>
              </div>

              <!-- Status Badge -->
              <div class="ml-4">
                <% case store.status %>
                <% when 'completed' %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-500/20 text-green-400 border border-green-500/30">
                    완료
                  </span>
                <% when 'scraping' %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-500/20 text-yellow-400 border border-yellow-500/30">
                    분석중
                  </span>
                <% when 'pending' %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-500/20 text-blue-400 border border-blue-500/30">
                    대기중
                  </span>
                <% when 'failed' %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-500/20 text-red-400 border border-red-500/30">
                    실패
                  </span>
                <% end %>
              </div>
            </div>

            <!-- Store Stats -->
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div class="text-center p-3 bg-gray-700/30 rounded-lg">
                <div class="text-lg font-bold text-white"><%= store.product_count || 0 %></div>
                <div class="text-xs text-gray-400">상품 수</div>
              </div>
              <div class="text-center p-3 bg-gray-700/30 rounded-lg">
                <div class="text-lg font-bold text-white">
                  <%= store.average_price && store.average_price > 0 ? "#{number_with_delimiter(store.average_price)}원" : "N/A" %>
                </div>
                <div class="text-xs text-gray-400">평균 가격</div>
              </div>
            </div>

            <!-- Additional Info -->
            <div class="flex items-center justify-between text-sm">
              <div class="flex items-center text-gray-400">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                <%= store.display_follower_count %>
              </div>

              <% if store.rating > 0 %>
                <div class="flex items-center text-yellow-400">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                  </svg>
                  <%= store.rating %>
                </div>
              <% end %>

              <div class="text-gray-500">
                <%= store.business_type&.humanize || "N/A" %>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex gap-2 mt-4">
              <%= link_to store_path(store),
                  class: "flex-1 bg-blue-500/20 hover:bg-blue-500/30 text-blue-400 border border-blue-500/30 hover:border-blue-500 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300 text-center" do %>
                상세보기
              <% end %>

              <% if store.needs_update? %>
                <%= link_to refresh_store_path(store), method: :post,
                    class: "bg-green-500/20 hover:bg-green-500/30 text-green-400 border border-green-500/30 hover:border-green-500 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300" do %>
                  새로고침
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <div class="mt-8 flex justify-center">
      <%= paginate @stores %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="text-center py-16">
      <div class="w-24 h-24 bg-gray-700/50 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-12 h-12 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-white mb-2">스토어가 없습니다</h3>
      <p class="text-gray-400 mb-6">첫 번째 네이버 스마트스토어를 추가해서 분석을 시작해보세요!</p>
      <p class="text-sm text-gray-500">
        URL 예시: https://smartstore.naver.com/saramdel
      </p>
    </div>
  <% end %>
</div>

<!-- Auto Refresh for Pending Stores -->
<% if @stores.where(status: ['pending', 'scraping']).any? %>
  <script>
    // Auto refresh every 30 seconds if there are pending stores
    setTimeout(function() {
      location.reload();
    }, 30000);
  </script>
<% end %>
